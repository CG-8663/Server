#!/usr/bin/env bash
# omarchy-server: check, open, start, stop and restart Omarchy Server on this machine.
#   omarchy-server              status and address
#   omarchy-server open         open the web app
#   omarchy-server restart      restart both services (also: start, stop)
#   omarchy-server logs [-f]    recent log lines (follow with -f)
#   omarchy-server widget on    add the status icon to the top bar (off to remove)
#   omarchy-server uninstall    remove Omarchy Server, keeping your data (--purge deletes that too)
set -u
UNITS=(omarchyd.service omarchy-server-web.service)
DESKTOP_UNIT=omarchy-server-desktop.service
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PORT=$(sed -n 's/.*server\/cli\.mjs --port \([0-9]*\).*/\1/p' "$UNIT_DIR/omarchy-server-web.service" 2>/dev/null | head -1)
PORT=${PORT:-7780}
WAYBAR="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
MARK='omarchy-server widget'

ip_addr() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}'; }
running() { systemctl --user is-active --quiet omarchyd.service 2>/dev/null && systemctl --user is-active --quiet omarchy-server-web.service 2>/dev/null; }
notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Omarchy Server" "Omarchy Server" "$1"; printf '%s\n' "$1"; }
reload_bar() { if command -v omarchy-restart-waybar >/dev/null 2>&1; then omarchy-restart-waybar >/dev/null 2>&1; else pkill -SIGUSR2 waybar 2>/dev/null; fi; }

# uninstall: take Omarchy Server off this machine. By default your data stays (account, apps and their
# data, machines and their disks), so installing again picks up where you left off. --purge deletes it.
# Packages, your files and ~/Pools are never touched.
BASE="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-server"
LAUNCHERS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

# Apps and machines Omarchy Server made that still exist (one per line). Apps are compose projects named
# omarchy-<id>; podman's JSON output is read because its --format text differs between versions.
leftovers() {
	podman ps -a --filter label=com.docker.compose.project --format json 2>/dev/null | node -e '
		let s = ""
		process.stdin.on("data", (d) => (s += d)).on("end", () => {
			try {
				const names = new Set()
				for (const c of JSON.parse(s || "[]")) {
					const p = c.Labels?.["com.docker.compose.project"]
					if (typeof p === "string" && p.startsWith("omarchy-")) names.add(p.slice(8))
				}
				for (const n of [...names].sort()) console.log("app: " + n)
			} catch {}
		})'
	virsh -c qemu:///session list --all --name 2>/dev/null | grep '^omarchy-' | sed 's/^omarchy-/machine: /'
}

# True when podman and libvirt (whichever are installed) can say what they hold. --purge deletes data, so it
# must not treat "could not ask" as "nothing there".
can_ask() {
	if command -v podman >/dev/null 2>&1; then podman ps -a --format json >/dev/null 2>&1 || return 1; fi
	if command -v virsh >/dev/null 2>&1; then virsh -c qemu:///session list --all --name >/dev/null 2>&1 || return 1; fi
	return 0
}

do_uninstall() {
	local purge=$1 yes=$2 left word answer link
	if [ "$purge" = 1 ] && ! can_ask; then
		echo "Couldn't ask podman and libvirt what Omarchy Server still has, so nothing was deleted. Nothing was changed."
		exit 1
	fi
	left=$(leftovers)
	if [ "$purge" = 1 ] && [ -n "$left" ]; then
		printf 'These apps and machines were made by Omarchy Server and still exist:\n%s\n\n' "$left"
		echo "Remove them first (Apps, then Uninstall; Machines, then Delete), then run this again. Nothing was changed."
		exit 1
	fi
	if [ "$purge" = 1 ]; then
		printf 'This removes Omarchy Server AND everything it keeps (%s, %s):\n' "$BASE" "$(du -sh "$BASE" 2>/dev/null | cut -f1)"
		echo "  your account, installed apps and their data, machines and their disks."
	else
		echo "This removes Omarchy Server's program, services, launcher entries, top-bar icon, storage helper and firewall rules."
		echo "It keeps your account, apps and their data, and machines and their disks ($BASE),"
		echo "so installing again picks up where you left off. Add --purge to delete those too."
		[ -n "$left" ] && printf '\nThese keep running, because their data stays:\n%s\n' "$left"
	fi
	printf '\nYour files, ~/Pools and the installed packages are not touched.\n'
	if [ "$yes" != 1 ]; then
		if ! ( : </dev/tty ) 2>/dev/null; then echo "There is no terminal to ask in. Add -y to go ahead without asking."; exit 1; fi
		word=uninstall; [ "$purge" = 1 ] && word=delete
		printf '\nType "%s" to continue: ' "$word" >/dev/tty
		read -r answer </dev/tty
		[ "$answer" = "$word" ] || { echo "Nothing was changed."; exit 1; }
	fi

	"$0" widget off >/dev/null 2>&1 || true
	systemctl --user disable --now "${UNITS[@]}" "$DESKTOP_UNIT" >/dev/null 2>&1
	rm -f "$UNIT_DIR/omarchyd.service" "$UNIT_DIR/omarchy-server-web.service" "$UNIT_DIR/$DESKTOP_UNIT"
	systemctl --user daemon-reload
	systemctl --user reset-failed >/dev/null 2>&1
	rm -f "$LAUNCHERS/omarchy-server.desktop" "$LAUNCHERS/omarchy-server-restart.desktop"
	link="$HOME/.local/bin/omarchy-server"
	[ "$(readlink "$link" 2>/dev/null)" = "$BASE/app/bin/omarchy-server" ] && rm -f "$link"

	echo "Removing the storage helper and firewall rules (sudo needed)"
	if command -v ufw >/dev/null 2>&1; then
		for rule in "$PORT/tcp" 40000:49999/tcp 40000:49999/udp 7800:7899/tcp; do sudo ufw delete allow "$rule" >/dev/null 2>&1 || true; done
	fi
	sudo rm -f /etc/sudoers.d/omarchy-server
	sudo rm -rf /usr/local/libexec/omarchy-server

	rm -rf "$BASE/app" "$BASE/install.log" "$BASE/.widget-offered"
	if [ "$purge" = 1 ]; then
		# App folders can belong to the apps' own user ids, so they go through podman, as the server does.
		podman unshare rm -rf "$BASE/omarchyd/apps" >/dev/null 2>&1
		rm -rf "$BASE"
		echo "Omarchy Server and its data are gone."
	else
		echo "Omarchy Server is removed. Your data is still in $BASE."
	fi
	echo "Left as they were: the installed packages, the 'run while logged out' setting, and ~/Pools."
	exit 0
}

case "${1:-status}" in
	status)
		for u in "${UNITS[@]}" "$DESKTOP_UNIT"; do printf '%-34s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null)"; done
		running && printf '\nOpen http://%s:%s (or http://localhost:%s on this machine)\n' "$(ip_addr)" "$PORT" "$PORT"
		;;
	open) xdg-open "http://localhost:$PORT" >/dev/null 2>&1 & ;;
	start | stop | restart)
		systemctl --user "$1" "${UNITS[@]}"
		# Desktop sharing only runs inside a signed-in Omarchy session.
		systemctl --user is-active --quiet graphical-session.target 2>/dev/null && systemctl --user "$1" "$DESKTOP_UNIT" 2>/dev/null
		sleep 1
		if [ "$1" = stop ]; then notify "Stopped"; elif running; then notify "Running at http://$(ip_addr):$PORT"; else notify "Didn't start. See: omarchy-server logs"; fi
		;;
	logs)
		if [ "${2:-}" = -f ]; then journalctl --user -u omarchyd -u omarchy-server-web -f; else journalctl --user -u omarchyd -u omarchy-server-web -n 80 --no-pager; fi
		;;
	waybar)
		# One line of JSON for Waybar's custom module.
		if running; then
			printf '{"text":"󰒋","class":"running","tooltip":"Omarchy Server is running\\nhttp://%s:%s\\n\\nClick: open · Right-click: restart"}\n' "$(ip_addr)" "$PORT"
		else
			printf '{"text":"󰒋 off","class":"stopped","tooltip":"Omarchy Server is stopped\\n\\nRight-click: start it"}\n'
		fi
		;;
	widget)
		# Current Omarchy draws its own top bar (omarchy-shell, configured in ~/.config/omarchy/shell.json);
		# older Omarchy used Waybar. The icon goes into whichever this desktop has.
		SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
		OM_PATH="${OMARCHY_PATH:-}"; [ -z "$OM_PATH" ] && for d in /usr/share/omarchy "$HOME/.local/share/omarchy"; do [ -d "$d" ] && { OM_PATH=$d; break; }; done
		if [ -f "$SHELL_JSON" ] || [ -f "$OM_PATH/config/omarchy/shell.json" ]; then
			node - "${2:-on}" "$SHELL_JSON" "$OM_PATH/config/omarchy/shell.json" "$HOME/.local/bin/omarchy-server" <<'EOF' || { echo "Couldn't update the top bar; your bar settings are unchanged."; exit 1; }
const fs = require('node:fs')
const [mode, file, defaults, bin] = process.argv.slice(2)
const read = (f) => JSON.parse(fs.readFileSync(f, 'utf8'))
const cfg = fs.existsSync(file) ? read(file) : read(defaults) // once customised, shell.json is the whole config
cfg.bar ??= {}
cfg.bar.layout ??= {}
const sections = Object.values(cfg.bar.layout).filter(Array.isArray)
const has = sections.some((s) => s.some((e) => e?.id === 'omarchy-server'))
if (mode === 'on') {
  if (has) { console.log('The widget is already on.'); process.exit(0) }
  cfg.bar.layout.right ??= []
  cfg.bar.layout.right.unshift({id: 'omarchy-server', type: 'command', exec: `${bin} waybar`, interval: 10, tooltip: 'Omarchy Server', onClick: `${bin} open`})
} else if (mode === 'off') {
  if (!has) { console.log('The widget is not on.'); process.exit(0) }
  for (const k of Object.keys(cfg.bar.layout)) if (Array.isArray(cfg.bar.layout[k])) cfg.bar.layout[k] = cfg.bar.layout[k].filter((e) => e?.id !== 'omarchy-server')
} else { console.log('Use: omarchy-server widget on|off'); process.exit(2) }
if (fs.existsSync(file)) fs.copyFileSync(file, `${file}.omarchy-server.bak`)
fs.mkdirSync(require('node:path').dirname(file), {recursive: true})
const tmp = `${file}.tmp-${process.pid}`
fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + '\n')
fs.renameSync(tmp, file)
console.log(mode === 'on' ? 'Added the Omarchy Server icon to the top bar. Remove it with: omarchy-server widget off' : 'Removed the Omarchy Server icon.')
EOF
			command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell shell reloadConfig >/dev/null 2>&1
			exit 0
		fi
		[ -f "$WAYBAR" ] || { echo "No Omarchy top bar settings found (shell.json or Waybar)."; exit 1; }
		case "${2:-on}" in
			on)
				grep -q "$MARK" "$WAYBAR" && { echo "The widget is already on."; exit 0; }
				cp "$WAYBAR" "$WAYBAR.omarchy-server.bak"
				node - "$WAYBAR" "$MARK" <<'EOF' || { echo "Couldn't find where to add it in $WAYBAR; your config is unchanged."; exit 1; }
const fs = require('node:fs')
const [file, mark] = process.argv.slice(2)
let text = fs.readFileSync(file, 'utf8')
const list = /"modules-right"\s*:\s*\[/
if (!list.test(text) || !/^\s*\{/.test(text)) process.exit(1)
text = text.replace(list, (m) => `${m}\n    "custom/omarchy-server", // ${mark}`)
const bin = `${process.env.HOME}/.local/bin/omarchy-server`
const def = `\n  // ${mark} start\n  "custom/omarchy-server": {\n    "exec": "${bin} waybar",\n    "return-type": "json",\n    "interval": 10,\n    "on-click": "${bin} open",\n    "on-click-right": "${bin} restart"\n  },\n  // ${mark} end`
text = text.replace(/^(\s*)\{/, (m) => `${m}${def}`)
fs.writeFileSync(file, text)
EOF
				reload_bar
				echo "Added the Omarchy Server icon to the top bar. Remove it with: omarchy-server widget off"
				;;
			off)
				grep -q "$MARK" "$WAYBAR" || { echo "The widget isn't on."; exit 0; }
				sed -i "/\/\/ $MARK start/,/\/\/ $MARK end/d; /\/\/ $MARK\$/d" "$WAYBAR"
				reload_bar
				echo "Removed the Omarchy Server icon."
				;;
			*) echo "Use: omarchy-server widget on|off"; exit 2 ;;
		esac
		;;
	uninstall)
		shift
		purge=0 yes=0
		for a in "$@"; do
			case "$a" in
				--purge) purge=1 ;;
				-y | --yes) yes=1 ;;
				*) echo "Use: omarchy-server uninstall [--purge] [-y]"; exit 2 ;;
			esac
		done
		do_uninstall "$purge" "$yes"
		;;
	-h | --help | help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) echo "Unknown command: $1 (try: omarchy-server help)"; exit 2 ;;
esac
